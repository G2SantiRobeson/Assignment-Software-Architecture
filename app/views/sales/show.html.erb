<% content_for :title, "#{@sale.book.name} sales in #{@sale.year}" %><div class="page-header"><h1>Yearly sale</h1><div class="actions"><%= link_to "Edit", edit_sale_path(@sale), class: "button secondary" %><%= button_to "Delete", @sale, method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete this sale?" } } %></div></div>
<div class="card"><dl class="details"><dt>Book</dt><dd><%= link_to @sale.book.name, @sale.book %></dd><dt>Author</dt><dd><%= link_to @sale.book.author.name, @sale.book.author %></dd><dt>Year</dt><dd><%= @sale.year %></dd><dt>Sales</dt><dd><%= number_with_delimiter(@sale.sales) %></dd></dl></div>
