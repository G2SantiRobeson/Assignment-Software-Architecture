<% content_for :title, "Review of #{@review.book.name}" %><div class="page-header"><h1>Review of <%= @review.book.name %></h1><div class="actions"><%= link_to "Edit", edit_review_path(@review), class: "button secondary" %><%= button_to "Delete", @review, method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete this review?" } } %></div></div>
<div class="card"><dl class="details"><dt>Book</dt><dd><%= link_to @review.book.name, @review.book %></dd><dt>Author</dt><dd><%= link_to @review.book.author.name, @review.book.author %></dd><dt>Score</dt><dd><%= @review.score %>/5</dd><dt>Up-votes</dt><dd><%= @review.up_votes %></dd><dt>Review</dt><dd><%= @review.review_text %></dd></dl></div>
