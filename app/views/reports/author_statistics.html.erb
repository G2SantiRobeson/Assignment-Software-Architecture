<% content_for :title, "Author statistics" %>
<h1>Author statistics</h1>
<p class="muted">Authors without books, reviews, or sales remain visible with zero values. Numeric filters are inclusive.</p>
<%= form_with url: author_statistics_path, method: :get, class: "filters" do |form| %>
  <div><%= form.label :author, "Author contains" %><%= form.text_field :author, value: params[:author] %></div>
  <div><%= form.label :published_books_min, "Minimum books" %><%= form.number_field :published_books_min, value: params[:published_books_min], min: 0 %></div>
  <div><%= form.label :published_books_max, "Maximum books" %><%= form.number_field :published_books_max, value: params[:published_books_max], min: 0 %></div>
  <div><%= form.label :average_score_min, "Minimum average" %><%= form.number_field :average_score_min, value: params[:average_score_min], min: 0, max: 5, step: 0.01 %></div>
  <div><%= form.label :average_score_max, "Maximum average" %><%= form.number_field :average_score_max, value: params[:average_score_max], min: 0, max: 5, step: 0.01 %></div>
  <div><%= form.label :total_sales_min, "Minimum sales" %><%= form.number_field :total_sales_min, value: params[:total_sales_min], min: 0 %></div>
  <div><%= form.label :total_sales_max, "Maximum sales" %><%= form.number_field :total_sales_max, value: params[:total_sales_max], min: 0 %></div>
  <%= form.hidden_field :sort, value: params[:sort] %><%= form.hidden_field :direction, value: params[:direction] %>
  <div class="form-actions"><%= form.submit "Apply filters" %><%= link_to "Clear", author_statistics_path, class: "button secondary" %></div>
<% end %>
<div class="table-wrap"><table><thead><tr><th><%= statistics_sort_link "Author", "author" %></th><th><%= statistics_sort_link "Published books", "published_books" %></th><th><%= statistics_sort_link "Average score", "average_score" %></th><th><%= statistics_sort_link "Total sales", "total_sales" %></th></tr></thead><tbody>
  <% @statistics.each do |author| %><tr><td><%= link_to author.name, author %></td><td><%= author.published_books_count.to_i %></td><td><%= number_with_precision(author.average_score.to_f, precision: 2) %></td><td><%= number_with_delimiter(author.total_sales.to_i) %></td></tr><% end %>
  <% if @statistics.empty? %><tr><td colspan="4" class="empty">No authors match these filters.</td></tr><% end %>
</tbody></table></div>
