# Copy this file to .env and replace the development-only example password.
# .env is ignored by Git and is read automatically by Docker Compose.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-password

# Native Rails defaults; Compose entry files set their own feature flags/URLs.
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
SEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=book_reviews_development_v1

# Assignment 4: script/edge.ps1 init appends a generated SECRET_KEY_BASE to .env.
APP_HOST=app.localhost
APP_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
# Container mount and Active Storage root (the same value on every replica).
UPLOADS_PATH=/rails/storage
MAX_IMAGE_BYTES=5242880
