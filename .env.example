# Copy this file to .env and replace the development-only example password.
# .env is ignored by Git and is read automatically by Docker Compose.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-password

# Native Rails defaults; Compose entry files set their own feature flags/URLs.
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
SEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=book_reviews_development_v1
